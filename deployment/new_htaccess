# ========================================
# RHD BEARINGS - CLEAN URL CONFIGURATION
# ========================================
# This .htaccess file enables clean URLs for all series and model pages
# Users can access /specs/6000-series/ instead of /specs/6000-series.html
# ========================================

# IMPORTANT: Custom rules must come BEFORE WordPress rules
# URL Rewriting for Clean URLs (No .html extension needed)
RewriteEngine On

# Force direct serving of HTML files, bypass WordPress
<Files "*.html">
    SetHandler default-handler
</Files>

# Series Pages - Clean URLs (no .html extension needed)
RewriteRule ^specs/miniature-series/?$ /specs/miniature-series.html [L]
RewriteRule ^specs/6000-series/?$ /specs/6000-series.html [L]
RewriteRule ^specs/6200-series/?$ /specs/6200-series.html [L]
RewriteRule ^specs/6300-series/?$ /specs/6300-series.html [L]
RewriteRule ^specs/62200-series/?$ /specs/62200-series.html [L]
RewriteRule ^specs/62300-series/?$ /specs/62300-series.html [L]
RewriteRule ^specs/16000-series/?$ /specs/16000-series.html [L]
RewriteRule ^specs/6800-series/?$ /specs/6800-series.html [L]
RewriteRule ^specs/6900-series/?$ /specs/6900-series.html [L]

# Additional Series Pages (if any exist)
# This rule automatically handles any series page with the pattern: /specs/NAME-series/
# It will redirect to /specs/NAME-series.html without showing the .html extension
RewriteRule ^specs/([a-zA-Z0-9-]+)-series/?$ /specs/$1-series.html [L]

# Individual Model Pages
RewriteRule ^specs/miniature-series/604/?$ /specs/miniature-series/604/index.html [L]
