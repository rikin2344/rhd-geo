# =============================================================================
# RHD BEARINGS WORDPRESS AUTOMATION - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual credentials
# Never commit the .env file to version control!

# =============================================================================
# WORDPRESS CONFIGURATION
# =============================================================================

# WordPress Site URL (without trailing slash)
WORDPRESS_URL=https://rhdbearings.com

# WordPress Admin Credentials
WORDPRESS_USERNAME=rhdbearings
WORDPRESS_PASSWORD=Rikin@2025#

# WordPress REST API Application Password
# Generate this in: WP Admin → Users → Profile → Application Passwords
# Format: username:application_password
WORDPRESS_APP_PASSWORD=rhdbearings:xxxx xxxx xxxx xxxx xxxx xxxx

# WordPress REST API Base URL
WORDPRESS_API_URL=https://rhdbearings.com/wp-json/wp/v2

# =============================================================================
# CPANEL / HOSTING CONFIGURATION
# =============================================================================

# cPanel Login URL
CPANEL_URL=https://your-hosting-provider.com:2083

# cPanel Credentials
CPANEL_USERNAME=your_cpanel_username
CPANEL_PASSWORD=your_cpanel_password

# FTP/SFTP Configuration (Alternative to cPanel)
FTP_HOST=ftp.rhdbearings.com
FTP_PORT=21
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_ROOT_PATH=/public_html

# SFTP Configuration (if available)
SFTP_HOST=rhdbearings.com
SFTP_PORT=22
SFTP_USERNAME=your_sftp_username
SFTP_PASSWORD=your_sftp_password
SFTP_ROOT_PATH=/public_html

# =============================================================================
# AUTOMATION CONFIGURATION
# =============================================================================

# Deployment Settings
DEPLOY_MODE=production
# Options: development, staging, production

# Batch Processing
BATCH_SIZE=10
# Number of pages to create per batch (to avoid rate limiting)

DELAY_BETWEEN_BATCHES=2
# Seconds to wait between batches

MAX_RETRIES=3
# Number of retry attempts for failed operations

# =============================================================================
# CONTENT CONFIGURATION
# =============================================================================

# Data Source Files
BEARINGS_DATA_FILE=output/generated_bearings_complete.json
SERIES_DATA_FILE=output/enhanced_bearing_series_pages.json
WITTY_DESCRIPTIONS_FILE=rhd_bearings/data/witty_bearing_descriptions.json

# Image Configuration
IMAGES_DIRECTORY=images
TECHNICAL_DRAWINGS_PATH=technical_drawings
DEFAULT_BEARING_IMAGE=DGBB.png

# URL Structure Configuration
BASE_SERIES_URL_PATTERN=/{series-name}
BASE_BEARING_URL_PATTERN=/{series-name}/{model-number}

# =============================================================================
# SEO CONFIGURATION
# =============================================================================

# Default SEO Settings
DEFAULT_META_DESCRIPTION_SUFFIX=| RHD Bearings Mumbai, India
DEFAULT_KEYWORDS_BASE=bearings, ball bearings, RHD bearings, Mumbai, India, industrial bearings

# Google Analytics (if needed)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Search Console (if needed)
GOOGLE_SITE_VERIFICATION=your_verification_code

# =============================================================================
# WORDPRESS THEME CONFIGURATION
# =============================================================================

# Theme Settings
ACTIVE_THEME_NAME=your_theme_name
CUSTOM_CSS_FILE_PATH=/wp-content/themes/your_theme/style.css

# Custom Post Types (if using)
USE_CUSTOM_POST_TYPES=false
BEARING_POST_TYPE=bearing
SERIES_POST_TYPE=bearing_series

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE_PATH=logs/wordpress_automation.log
ERROR_LOG_FILE=logs/errors.log

# Notification Settings (optional)
ENABLE_EMAIL_NOTIFICATIONS=false
NOTIFICATION_EMAIL=admin@rhdbearings.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
ENABLE_BACKUPS=true
BACKUP_DIRECTORY=backups
BACKUP_BEFORE_DEPLOYMENT=true

# Database Backup (if needed)
DB_BACKUP_ENABLED=false
DB_HOST=localhost
DB_NAME=wordpress_db
DB_USERNAME=db_user
DB_PASSWORD=db_password

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development Mode Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false
DRY_RUN_MODE=false
# Set to true to test without actually creating pages

# Test Configuration
TEST_SERIES=miniature_bearings
TEST_BEARING_COUNT=5
# For testing with limited data

# =============================================================================
# RATE LIMITING AND PERFORMANCE
# =============================================================================

# API Rate Limiting
REQUESTS_PER_MINUTE=60
CONCURRENT_REQUESTS=5

# Performance Settings
ENABLE_CACHING=true
CACHE_DIRECTORY=cache
CACHE_EXPIRY_HOURS=24

# Image Optimization
OPTIMIZE_IMAGES=true
MAX_IMAGE_WIDTH=1200
MAX_IMAGE_HEIGHT=800
IMAGE_QUALITY=85

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Security Configuration
ENABLE_SSL_VERIFICATION=true
USER_AGENT=RHD-Bearings-Automation/1.0

# API Security
API_TIMEOUT=30
MAX_REDIRECTS=5

# File Upload Security
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif,svg,webp
MAX_FILE_SIZE_MB=10

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Toggles
ENABLE_SERIES_PAGES=true
ENABLE_INDIVIDUAL_PAGES=true
ENABLE_IMAGE_UPLOADS=true
ENABLE_SEO_OPTIMIZATION=true
ENABLE_INTERNAL_LINKING=true
ENABLE_SITEMAP_GENERATION=true

# Advanced Features
ENABLE_SCHEMA_MARKUP=true
ENABLE_BREADCRUMBS=true
ENABLE_RELATED_PRODUCTS=true
ENABLE_SEARCH_FUNCTIONALITY=true

# =============================================================================
# MAINTENANCE SETTINGS
# =============================================================================

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="Site under maintenance. Please check back soon."

# Cleanup Settings
AUTO_CLEANUP_LOGS=true
LOG_RETENTION_DAYS=30
AUTO_CLEANUP_CACHE=true
CACHE_CLEANUP_INTERVAL_HOURS=24

# =============================================================================
# RANK MATH SEO CONFIGURATION
# =============================================================================

# Rank Math SEO Plugin Settings
RANKMATH_SEO_ENABLED=true
RANKMATH_API_ENABLED=true

# Rank Math AI SEO Settings
RANKMATH_AI_ENABLED=true
RANKMATH_AI_API_KEY=your_rankmath_ai_api_key
# Get this from: Rank Math → General Settings → AI

# Schema Markup (Rank Math handles this automatically)
ENABLE_PRODUCT_SCHEMA=true
ENABLE_ORGANIZATION_SCHEMA=true
ENABLE_BREADCRUMB_SCHEMA=true

# Rank Math Focus Keywords (Auto-generated)
AUTO_GENERATE_FOCUS_KEYWORDS=true
PRIMARY_KEYWORD_PATTERN={bearing_model} bearing
SECONDARY_KEYWORDS_PATTERN={series_name} bearings, {bore_size}mm bearing, RHD bearings

# Rank Math Content AI
CONTENT_AI_OPTIMIZATION=true
AUTO_INTERNAL_LINKING=true
CONTENT_AI_SUGGESTIONS=true

# Social Media (Rank Math handles Open Graph automatically)
FACEBOOK_APP_ID=your_facebook_app_id
TWITTER_USERNAME=@rhdbearings

# Google Services Integration
GOOGLE_ANALYTICS_4_ID=G-XXXXXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=your_verification_code
GOOGLE_ADSENSE_ID=ca-pub-xxxxxxxxxx

# Rank Math Sitemap (Auto-generated)
RANKMATH_SITEMAP_ENABLED=true
EXCLUDE_ATTACHMENT_SITEMAP=true
SITEMAP_IMAGES=true

# Performance & Indexing
RANKMATH_INSTANT_INDEXING=true
GOOGLE_INDEXING_API_KEY=your_indexing_api_key

