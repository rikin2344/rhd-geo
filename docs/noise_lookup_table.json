      "series": "6300_series",
      "lookup_key": "45", 
      "result": {
        "Z2": 51,
        "Z3": 47,
        "Z4": 44
      }
    },
    "implementation_code": "const series = getBearingSeries(bearing.model_number);\nconst noiseData = noise_lookup_table.data[bearing.bore_diameter.toString()][series];"
  },
