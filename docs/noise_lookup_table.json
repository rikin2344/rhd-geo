  "series_detection": {
    "function_logic": "Determine bearing series from model number",
    "rules": {
      "6000_series": ["600", "601", "602", "603", "604", "605", "606", "607", "608", "609", "6000", "6001", "6002", "6003", "6004", "6005", "6006", "6007", "6008", "6009", "6010", "6011", "6012", "6013", "6014", "6015", "6016", "6017", "6018", "6019", "6020"],
      "6200_series": "Models starting with '62'",
      "6300_series": "Models starting with '63'"
    },
    "javascript_function": "function getBearingSeries(modelNumber) {\n  const model = modelNumber.toString();\n  if (model.match(/^60\\d{1,2}$/) || model.match(/^6\\d{3}$/) && model.startsWith('60')) {\n    return '6000_series';\n  }\n  if (model.startsWith('62')) {\n    return '6200_series';\n  }\n  if (model.startsWith('63')) {\n    return '6300_series';\n  }\n  return null;\n}"
  },
  "usage_instructions": {
    "lookup_method": "Use bore diameter AND bearing series to find noise data",
    "step1": "Determine bearing series from model number",
    "step2": "Use bore diameter as key",
    "step3": "Access series-specific noise data",
    "example_6201": {
      "bearing": "6201",
      "bore_diameter": 12,
      "series": "6200_series",
      "lookup_key": "12",
      "result": {
        "Z2": 39,
        "Z3": 35,
        "Z4": 30
      }
    },
